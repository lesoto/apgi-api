# Standalone APGI API - Production Environment Configuration Template
# IMPORTANT: This is a template. Copy and configure with actual production values.
# NEVER commit production secrets to version control!

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=production

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=0.0.0.0
PORT=8000
RELOAD=false

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# REQUIRED: Configure production PostgreSQL connection
# Format: postgresql://username:password@host:port/database
# Example: postgresql://apgi_prod:SECURE_PASSWORD@db.example.com:5432/apgi_api_prod
# Use SSL/TLS connection: postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/apgi_api_prod

# =============================================================================
# REDIS SETTINGS
# =============================================================================
# REQUIRED: Configure production Redis connection
# Format: redis://host:port/db or rediss://host:port/db (SSL)
# Example: rediss://redis.example.com:6379/0
REDIS_URL=redis://CHANGE_ME:6379/0

# =============================================================================
# CELERY SETTINGS
# =============================================================================
# REQUIRED: Configure production Celery broker and backend
CELERY_BROKER_URL=redis://CHANGE_ME:6379/1
CELERY_RESULT_BACKEND=redis://CHANGE_ME:6379/2

# =============================================================================
# AUTHENTICATION SETTINGS
# =============================================================================
# CRITICAL: Generate a secure random JWT secret key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NEVER use default or development keys in production!
JWT_SECRET_KEY=CHANGE_ME_TO_SECURE_RANDOM_STRING_MIN_32_CHARS

# Token expiration settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# RATE LIMITING SETTINGS
# =============================================================================
# Strict rate limiting for production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# CORS SETTINGS
# =============================================================================
# REQUIRED: Configure specific allowed origins (NEVER use * in production!)
# Example: https://app.example.com,https://www.example.com
CORS_ORIGINS=https://CHANGE_ME.com

# Allow credentials (required for cookie-based auth)
CORS_ALLOW_CREDENTIALS=true

# Restrict methods and headers as needed
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-CSRF-Token

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
# Production logging level (WARNING or ERROR recommended)
LOG_LEVEL=WARNING

# =============================================================================
# SCHEMA VALIDATION SETTINGS
# =============================================================================
# Enable schema validation in production
SCHEMA_VALIDATION_ENABLED=true
SCHEMA_VALIDATION_FAIL_ON_ERROR=false

# =============================================================================
# ALERTING SETTINGS
# =============================================================================
# Configure webhook URLs for production alerts (Slack, PagerDuty, etc.)
# Example: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_WEBHOOK_URLS=https://CHANGE_ME/webhook

# Enable console logging for alerts
ALERT_ENABLE_LOG_CHANNEL=true

# Alert thresholds for production
ALERT_ERROR_RATE_THRESHOLD=10
ALERT_ERROR_RATE_WINDOW_MINUTES=1
ALERT_COOLDOWN_MINUTES=5

# =============================================================================
# REQUEST SIZE LIMITING
# =============================================================================
# Maximum request body size in megabytes
MAX_REQUEST_SIZE_MB=10

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# [ ] JWT_SECRET_KEY is set to a secure random string (32+ characters)
# [ ] DATABASE_URL points to production database with SSL enabled
# [ ] REDIS_URL points to production Redis instance
# [ ] CORS_ORIGINS is set to specific allowed domains (not *)
# [ ] ALERT_WEBHOOK_URLS is configured for production monitoring
# [ ] All CHANGE_ME placeholders are replaced with actual values
# [ ] This file is NOT committed to version control
# [ ] Secrets are managed via secure secret management system
# [ ] Database backups are configured and tested
# [ ] Monitoring and alerting are set up
# [ ] SSL/TLS certificates are valid and configured
