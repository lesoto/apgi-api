# Standalone APGI API - Environment Configuration Example
# Copy this file to .env and configure your settings

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Environment: development, staging, or production
# This affects default settings and validation strictness
ENVIRONMENT=development

# =============================================================================
# SERVER SETTINGS
# =============================================================================
# Host to bind the API server (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Port to run the API server
PORT=8000

# Enable auto-reload on code changes (development only)
RELOAD=true

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
# Example: postgresql://apgi_user:secure_password@localhost:5432/apgi_api
DATABASE_URL=postgresql://apgi_dev:dev_password@localhost:5432/apgi_api_dev

# =============================================================================
# REDIS SETTINGS
# =============================================================================
# Redis connection URL for caching and session storage
# Format: redis://host:port/db
# Example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# CELERY SETTINGS
# =============================================================================
# Celery broker URL (Redis)
# Used for task queue message broker
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend URL (Redis)
# Used for storing task results
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# AUTHENTICATION SETTINGS
# =============================================================================
# JWT secret key for token signing
# CRITICAL: Must be a secure, random string with at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: Change this in production! Never commit real secrets to version control!
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# JWT algorithm (HS256 recommended)
# JWT_ALGORITHM=HS256

# JWT access token expiration in minutes (default: 30)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT refresh token expiration in days (default: 7)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# RATE LIMITING SETTINGS
# =============================================================================
# Enable rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# Maximum requests per minute per user/IP
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://app.example.com
# WARNING: Never use * with credentials enabled in production!
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Allow credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=true

# Allowed HTTP methods (comma-separated or *)
CORS_ALLOW_METHODS=*

# Allowed HTTP headers (comma-separated or *)
CORS_ALLOW_HEADERS=*

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: DEBUG (development), INFO (staging), WARNING (production)
LOG_LEVEL=INFO

# =============================================================================
# SCHEMA VALIDATION SETTINGS
# =============================================================================
# Enable response schema validation (true/false)
SCHEMA_VALIDATION_ENABLED=true

# Fail requests on schema validation errors (true/false)
# Set to false to log warnings instead of failing
SCHEMA_VALIDATION_FAIL_ON_ERROR=false

# =============================================================================
# ALERTING SETTINGS
# =============================================================================
# Comma-separated list of webhook URLs for alerts
# Example: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_WEBHOOK_URLS=

# Enable logging alerts to console (true/false)
ALERT_ENABLE_LOG_CHANNEL=true

# Error rate threshold for triggering alerts (errors per window)
ALERT_ERROR_RATE_THRESHOLD=10

# Time window for error rate calculation (minutes)
ALERT_ERROR_RATE_WINDOW_MINUTES=1

# Cooldown period between alerts (minutes)
ALERT_COOLDOWN_MINUTES=5

# =============================================================================
# REQUEST SIZE LIMITING
# =============================================================================
# Maximum request body size in megabytes
MAX_REQUEST_SIZE_MB=10
