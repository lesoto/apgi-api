# Production Environment Configuration Template
# Copy this file to .env.production and fill in the actual values

# Environment Settings
ENVIRONMENT=production
BASE_URL=https://api.yourdomain.com

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Security Settings
JWT_SECRET_KEY=your-very-secure-jwt-secret-key-here-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Redis Configuration
REDIS_URL=redis://hostname:6379/0
CELERY_BROKER_URL=redis://hostname:6379/1
CELERY_RESULT_BACKEND=redis://hostname:6379/2

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Logging Configuration
LOG_LEVEL=WARNING

# Schema Validation
SCHEMA_VALIDATION_ENABLED=true
SCHEMA_VALIDATION_FAIL_ON_ERROR=false

# Alerting Configuration
ALERT_WEBHOOK_URLS=https://alerts.yourdomain.com/webhook
ALERT_ENABLE_LOG_CHANNEL=true
ALERT_ERROR_RATE_THRESHOLD=10
ALERT_ERROR_RATE_WINDOW_MINUTES=1
ALERT_COOLDOWN_MINUTES=5

# Request Size Limiting
MAX_REQUEST_SIZE_MB=10
REQUEST_SIZE_LIMIT_ENABLED=true

# CSRF Protection
CSRF_PROTECTION_ENABLED=true

# Monitoring and Metrics
# Configure Prometheus metrics endpoint access
# Configure OpenTelemetry tracing if needed
