# Development Dockerfile for APGI Standalone API
# Includes hot-reload and development dependencies

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    libpq-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user with UID 1000
RUN useradd -m -u 1000 -s /bin/bash apgi && \
    chown -R apgi:apgi /app

# Copy requirements files
COPY --chown=apgi:apgi requirements.txt requirements-dev.txt ./

# Install both production and development dependencies
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-dev.txt

# Switch to non-root user
USER apgi

# Expose API port
EXPOSE 8000

# Source code will be mounted as a volume for hot-reload
# Default command with hot-reload enabled
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
